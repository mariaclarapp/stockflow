@startuml

top to bottom direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 45
skinparam padding 6


/' PRIMEIRA LINHA: MEDICAMENTOS '/

together {

    class SubgrupoGmus {
        - id : int
        - codigoGmus : int
        - nome : String
    }

    class Medicamento {
        - id : int
        - codigoGmus : String
        - descricao : String
        - unidade : String
    }

    class Classificacao {
        - id : int
        - nome : String
        - cor : String
        - descricao : String
        - ativo : boolean
    }

    class MedicamentoService {
        + consultarMedicamentos()
        + filtrarMedicamentos()
        + gerenciarClassificacoes()
    }
}


/' SEGUNDA LINHA: IMPORTAÇÕES '/

together {

    class Usuario {
        - id : int
        - username : String
        - email : String
        - ativo : boolean
    }

    class Ups {
        - id : int
        - codigoGmus : String
        - idUnidadeGmus : String
        - nome : String
        - participaCompetencia : boolean
        - compoeEstoqueConvencional : boolean
    }

    class Competencia {
        - id : int
        - mes : int
        - ano : int
    }

    class Importacao {
        - id : int
        - nomeArquivo : String
        - tipoRelatorio : String
        - dataImportacao : DateTime
        - status : String
    }

    class ImportacaoService {
        + identificarRelatorio()
        + importarEstoque()
        + importarMovimentacoes()
        + reimportar()
        + excluirImportacao()
    }
}


/' TERCEIRA LINHA: ESTOQUE E ANÁLISE '/

together {

    class SaldoEstoque {
        - id : int
        - quantidade : Decimal
    }

    class MovimentacaoEstoque {
        - id : int
        - dataInicial : Date
        - dataFinal : Date
        - saida : Decimal
        - compra : Decimal
        - transferenciaEntrada : Decimal
        - transferenciaSaida : Decimal
        - acertoEntrada : Decimal
        - acertoSaida : Decimal
        - saldoAtual : Decimal
    }

    class EstoqueService {
        + consolidarEstoque()
        + consultarHistorico()
        + validarMovimentacoes()
        + consultarDisponibilidade()
    }

    class AnaliseConsumoService {
        + calcularMediaSaidas()
        + compararPeriodos()
        + gerarEvolucao()
        + gerarRanking()
        + calcularCurvaABC()
        + calcularTendencia()
    }
}


/' RELACIONAMENTOS '/

SubgrupoGmus "0..1" -- "0..*" Medicamento
Medicamento "0..*" -- "0..*" Classificacao

Usuario "1" -- "0..*" Importacao
Ups "1" -- "0..*" Importacao
Competencia "1" -- "0..*" Importacao

Importacao "1" *-- "0..*" SaldoEstoque
Importacao "1" *-- "0..*" MovimentacaoEstoque

Medicamento "1" -- "0..*" SaldoEstoque
Medicamento "1" -- "0..*" MovimentacaoEstoque

Ups "1" -- "0..*" SaldoEstoque
Ups "1" -- "0..*" MovimentacaoEstoque

Competencia "1" -- "0..*" SaldoEstoque
Competencia "1" -- "0..*" MovimentacaoEstoque


/' DEPENDÊNCIAS DOS SERVIÇOS '/

MedicamentoService ..left.> Medicamento
ImportacaoService ..left.> Importacao

EstoqueService ..left.> SaldoEstoque
EstoqueService ..left.> MovimentacaoEstoque

AnaliseConsumoService ..left.> MovimentacaoEstoque


/' ORDEM HORIZONTAL DE CADA LINHA '/

SubgrupoGmus -[hidden]right- Medicamento
Medicamento -[hidden]right- Classificacao
Classificacao -[hidden]right- MedicamentoService

Usuario -[hidden]right- Ups
Ups -[hidden]right- Competencia
Competencia -[hidden]right- Importacao
Importacao -[hidden]right- ImportacaoService

SaldoEstoque -[hidden]right- MovimentacaoEstoque
MovimentacaoEstoque -[hidden]right- EstoqueService
EstoqueService -[hidden]right- AnaliseConsumoService


/' ORDEM VERTICAL DAS LINHAS '/

Medicamento -[hidden]down- Competencia
Competencia -[hidden]down- MovimentacaoEstoque

@enduml
