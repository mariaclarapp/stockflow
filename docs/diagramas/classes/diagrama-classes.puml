@startuml

top to bottom direction

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 40

package "Medicamentos" {
  class SubgrupoGmus {
    - id : int
    - codigoGmus : int [0..1]
    - nome : String
  }

  class Medicamento {
    - id : int
    - codigoGmus : String
    - descricao : String
    - unidade : String
  }

  class PrincipioAtivo {
    - id : int
    - nome : String
  }

  class Classificacao {
    - id : int
    - nome : String
    - cor : String
    - descricao : String
    - ativo : boolean
  }
}

package "Estoques" {
  class Lote {
    - id : int
    - codigoLote : String
    - dataValidade : Date [0..1]
  }

  class Estoque {
    - id : int
    - quantidade : Decimal
  }
}

package "Core" {
  class Ups {
    - id : int
    - codigoGmus : String
    - nome : String
    - participaCompetencia : boolean
    - compoeEstoqueConvencional : boolean
  }

  class Competencia {
    - id : int
    - mes : int
    - ano : int
  }
}

package "Importacoes" {
  enum StatusImportacao {
    concluida
    concluida_com_alertas
    concluida_parcial
  }

  class Importacao {
    - id : int
    - nomeArquivo : String
    - hashArquivo : String
    - tipoRelatorio : String
    - dataImportacao : DateTime
    - status : StatusImportacao
  }
}

package "Django (framework)" {
  class "User (AUTH_USER_MODEL)" as DjangoUser <<framework>> {
    - id : int
  }
}

SubgrupoGmus "0..1" -right- "0..*" Medicamento
Medicamento "0..*" -right- "0..*" PrincipioAtivo
Medicamento "0..*" -down- "0..*" Classificacao

Medicamento "1" -down- "0..*" Lote
Medicamento "1" -down- "0..*" Estoque
Ups "1" -left- "0..*" Estoque
Competencia "1" -left- "0..*" Estoque
Lote "0..1" -right- "0..*" Estoque
Importacao "1" -up- "0..*" Estoque

DjangoUser "1" -left- "0..*" Importacao : usuario
Ups "1" -down- "0..*" Importacao
Competencia "1" -down- "0..*" Importacao
Importacao ..> StatusImportacao

@enduml
